/Title (import time # Partition Function def partition\(arr, low, high\):     pivot = arr[high]      # Choose last element as pivot     i = low - 1     for j in range\(low, high\):         if arr[j] <= pivot:             i += 1             arr[i], arr[j] = arr[j], arr[i]     arr[i + 1], arr[high] = arr[high], arr[i + 1]     return i + 1 # Quick Sort Function def quick_sort\(arr, low, high\):     if low < high:)
/Dest [19 0 R /Fit]
/Parent 543 0 R
/Next 800 0 R
>>
endobj
